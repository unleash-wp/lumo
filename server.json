{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.unleash-wp/lumo",
  "description": "WordPress code review for AI-assisted development, checks PHP/JS against 42 source-verified entries (Core deprecations, Gutenberg/block.json, theme.json, WooCommerce HPOS) and returns the wrong-vs-correct fix with affected version range and dated source.",
  "repository": {
    "url": "https://github.com/unleash-wp/lumo",
    "source": "github"
  },
  "version": "0.4.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@unleashwp/lumo",
      "version": "0.4.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "-y",
          "valueHint": "flag"
        },
        {
          "type": "positional",
          "value": "-p",
          "valueHint": "flag"
        },
        {
          "type": "positional",
          "value": "@unleashwp/lumo",
          "valueHint": "package"
        },
        {
          "type": "positional",
          "value": "lumo-mcp",
          "valueHint": "binary"
        }
      ]
    }
  ]
}
